{
    "manifest_version": 3,
    "name": "Leads Tracker",
    "version": "1.0",
    "description": "Save and track important URLs",
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "favicon-16x16.png",
            "32": "favicon-32x32.png",
            "180": "apple-touch-icon.png"
        }
    },
    "permissions": [
        "activeTab"
    ],
    "icons": {
        "16": "favicon-16x16.png",
        "32": "favicon-32x32.png",
        "180": "apple-touch-icon.png"
    }
} 